{
  "Comment": "Simple ReAct-style agent for FDE learning",
  "StartAt": "ReceiveQuestion",
  "States": {
    "ReceiveQuestion": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:972553755953:function:decide_tool",
        "Payload.$": "$"
      },
    "ResultSelector": {
    "question.$": "$.Payload.question",
    "tool.$": "$.Payload.tool",
    "reason.$": "$.Payload.reason"
  },
      "Next": "ShouldCallTool"
    },
    "ShouldCallTool": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.tool",
          "StringEquals": "weather",
          "Next": "FetchWeather"
        },
        {
          "Variable": "$.tool",
          "StringEquals": "database",
          "Next": "FetchDatabase"
        }
      ],
      "Default": "SynthesizeAnswer"
    },
    "FetchWeather": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:972553755953:function:fetch_data",
        "Payload.$": "$"
      },
      "ResultPath": "$.tool_output",
      "Next": "SynthesizeAnswer"
    },
    "FetchDatabase": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:972553755953:function:fetch_data",
        "Payload.$": "$"
      },
        "ResultSelector": {
    "tool_output.$": "$.Payload.tool_output"
  },
      "ResultPath": "$.tool_output",
      "Next": "SynthesizeAnswer"
    },
    "SynthesizeAnswer": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:972553755953:function:synthesize",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "question.$": "$.Payload.question",
        "tool_used.$": "$.Payload.tool_used",
        "answer.$": "$.Payload.answer"
      },
      "End": true
    }
  }
}
