{
  "Comment": "Simple ReAct-style agent for FDE learning",
  "StartAt": "ReceiveQuestion",
  "States": {
    "ReceiveQuestion": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:755785010596:function:decide_tool",
        "Payload": {
          "question.$": "$.question"
        }
      },
      "ResultPath": "$.decision",
      "Next": "ShouldCallTool"
    },
    "ShouldCallTool": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.decision.Payload.tool",
          "StringEquals": "weather",
          "Next": "FetchWeather"
        },
        {
          "Variable": "$.decision.Payload.tool",
          "StringEquals": "database",
          "Next": "FetchDatabase"
        }
      ],
      "Default": "SynthesizeAnswer"
    },
    "FetchWeather": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:755785010596:function:fetch_data",
        "Payload": {
          "tool": "weather"
        }
      },
      "ResultPath": "$.tool_output",
      "Next": "SynthesizeAnswer"
    },
    "FetchDatabase": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:755785010596:function:fetch_data",
        "Payload": {
          "tool": "database"
        }
      },
      "ResultPath": "$.tool_output",
      "Next": "SynthesizeAnswer"
    },
    "SynthesizeAnswer": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:755785010596:function:synthesize",
        "Payload": {
          "question.$": "$.question",
          "tool_output.$": "$.tool_output.Payload",
          "tool.$": "$.decision.Payload.tool"
        }
      },
      "End": true
    }
  }
}
